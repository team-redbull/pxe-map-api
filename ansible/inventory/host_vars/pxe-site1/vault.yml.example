# Per-site secret for pxe-site1. This file is a TEMPLATE - it is NOT read
# by the playbook as-is (only *.yml files under host_vars/ are loaded, and
# this one ends in .yml.example so it's skipped).
#
# To use it:
#   1. cp vault.yml.example vault.yml
#   2. Generate a real per-site token (do NOT reuse the same token across
#      sites - if one site's PXE VM is compromised, the others must not be):
#        openssl rand -hex 32
#   3. Put it in vault.yml below.
#   4. Encrypt the file before it ever touches git:
#        ansible-vault encrypt inventory/host_vars/pxe-site1/vault.yml
#   5. Run the playbook with --ask-vault-pass (or --vault-password-file).
#
# Deliberately leaving pxe_map_api_token unset/empty is supported (the app
# runs unauthenticated with a loud startup warning - see CLAUDE.md), but
# requires also setting pxe_map_api_allow_no_auth: true in vars.yml, or the
# preflight check in roles/pxe_map_api/tasks/preflight.yml fails the run.
pxe_map_api_token: "REPLACE_ME_WITH_openssl_rand_-hex_32_OUTPUT"
