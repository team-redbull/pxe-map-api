# {{ ansible_managed }}
# Rendered by the pxe_map_api Ansible role for {{ inventory_hostname }} -
# edit inventory/host_vars/{{ inventory_hostname }}/ instead of this file,
# it will be overwritten on the next playbook run.
#
# See app/config.py: PXE_MAP_DIR is required, PXE_MAP_BIND and
# PXE_MAP_TOKEN are optional (a missing token disables auth entirely and
# logs a startup warning - the preflight check in this role's tasks refuses
# to deploy that way unless pxe_map_api_allow_no_auth is set).

PXE_MAP_DIR={{ pxe_map_api_dir }}
PXE_MAP_BIND={{ pxe_map_api_bind }}
{% if pxe_map_api_token %}
PXE_MAP_TOKEN={{ pxe_map_api_token }}
{% else %}
# PXE_MAP_TOKEN intentionally left unset for {{ inventory_hostname }}
# (pxe_map_api_allow_no_auth: true) - every route is UNAUTHENTICATED.
{% endif %}
