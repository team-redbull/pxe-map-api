# Local dev only. Copy to .env in the project root (git-ignored) and fill
# in real values - see README.md "Running locally" for how to load it.
# For the production systemd deployment, use deploy/env.example instead
# (installed to /etc/pxe-map-api/env by deploy/install.sh).

PXE_MAP_TOKEN=dev-token
PXE_MAP_DIR=/tmp/pxe-map-dev
PXE_MAP_BIND=0.0.0.0:8080
