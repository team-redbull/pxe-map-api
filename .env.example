# Local dev only. Copy to .env in the project root (git-ignored) and fill
# in real values - see README.md "Running locally" for how to load it.
# Production (5 site VMs) is deployed via ansible/ instead - each site's
# /etc/pxe-map-api/env is rendered from ansible/inventory/host_vars/<site>/,
# not copied from this file. See DEPLOY.md.

# Required. The service refuses to start without it (nowhere to write
# mappings to).
# Optional. If unset, every route is UNAUTHENTICATED and anyone who can
# reach PXE_MAP_BIND can rewrite PXE boot targets - a loud warning is
# logged at startup when this is left unset. Fine for a throwaway local
# dev directory; never leave unset in production.
PXE_MAP_TOKEN=dev-token

# Optional, defaults to 0.0.0.0:8080 if unset.
PXE_MAP_BIND=0.0.0.0:8080
