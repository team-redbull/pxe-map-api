# Bearer token clients must send as: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
PXE_MAP_TOKEN=changeme

# Directory that nginx serves read-only at /pxe-map/ (see README for the
# nginx config this pairs with). This service is the only writer to it.
PXE_MAP_DIR=/var/www/pxe-map

# host:port uvicorn binds to.
#
# Default here (0.0.0.0:8080) listens on every interface on the VM,
# including whatever network path serves PXE/TFTP/nginx traffic to booting
# hosts. Bearer-token auth is still required on every route except
# /healthz, but this is wider than SPEC.md's "narrowest sensible option"
# guidance - restrict with a host firewall (e.g. firewalld, only allow the
# central BMH-creation endpoint's source IP on 8080), or switch to a
# specific management-interface IP or 127.0.0.1 (+ SSH tunnel) if you don't
# need it reachable on every NIC.
PXE_MAP_BIND=0.0.0.0:8080
