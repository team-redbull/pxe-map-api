# Bearer token clients must send as: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
PXE_MAP_TOKEN=changeme

# Directory that nginx serves read-only at /pxe-map/ (see README for the
# nginx config this pairs with). This service is the only writer to it.
PXE_MAP_DIR=/var/www/pxe-map

# host:port uvicorn binds to.
#
# Narrowest sensible default: localhost only. Pair this with an SSH tunnel
# (or run the central BMH-creation endpoint's calls through a bastion) so
# the API is never exposed on an interface booting hosts can reach.
#
# If the central endpoint must reach this VM directly over the network,
# change this to the site VM's management-facing interface IP/port instead
# of 0.0.0.0 - never bind on the interface the PXE/TFTP/nginx traffic to
# booting hosts uses.
PXE_MAP_BIND=127.0.0.1:8000
